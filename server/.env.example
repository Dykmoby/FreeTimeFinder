# Copy this file to ".env" and adjust the values.

# Port the API/server listens on (the one you forward on your router).
PORT=4000

# Secret used to sign login tokens (JWT). Use a long random string in production!
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login stays valid.
TOKEN_EXPIRES_IN=7d

# The first admin account is created automatically on first start.
# Log in with these, then change the password from your profile.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_NICKNAME=Admin

# Comma-separated list of origins allowed during development (the Vite dev server).
# In production the server serves the built client itself, so CORS is not needed.
CLIENT_ORIGIN=http://localhost:5173
